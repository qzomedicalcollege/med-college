---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { ui } from '../i18n/ui';
import '../../style.css';

interface Props {
  title: string;
  description?: string;
  lang?: 'ru' | 'kk' | 'en';
}

const { title, description = 'Официальный сайт Кызылординского высшего медицинского колледжа', lang = 'ru' } = Astro.props;
---

<!DOCTYPE html>
<html lang={lang}>
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{title}</title>
  <meta name="description" content={description}>
  
  <!-- Open Graph / SEO -->
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  <meta property="og:type" content="website">
  <meta property="og:url" content={Astro.url.href}>
  <meta property="og:image" content={new URL('/med-college/logo.png', Astro.url)}>
  
  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content={title}>
  <meta name="twitter:description" content={description}>
  <meta name="twitter:image" content={new URL('/med-college/logo.png', Astro.url)}>
  
  <!-- FontAwesome for Icons -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
  
  <!-- Firebase v8 SDK (Global scripts for client-side use) -->
  <script is:inline defer src="https://www.gstatic.com/firebasejs/8.10.1/firebase-app.js"></script>
  <script is:inline defer src="https://www.gstatic.com/firebasejs/8.10.1/firebase-auth.js"></script>
  <script is:inline defer src="https://www.gstatic.com/firebasejs/8.10.1/firebase-firestore.js"></script>
  <script is:inline defer src="/med-college/firebase-config.js"></script>
</head>
<body>
  <!-- Preloader -->
  <div class="preloader" id="preloader">
    <div class="spinner"></div>
  </div>

  <Header lang={lang} />
  
  <slot />
  
  <Footer lang={lang} />

  <!-- Scroll to Top Button -->
  <button id="scrollToTop" class="scroll-to-top" aria-label="Наверх">
    <i class="fas fa-arrow-up"></i>
  </button>

  <!-- Global scripts client module -->
  <script is:inline src="/med-college/scripts/script.js?v=2.0"></script>
</body>
</html>
